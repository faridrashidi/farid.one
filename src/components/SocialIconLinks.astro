---
import { footerLinks } from "../data/profile";

interface Props {
  variant?: "footer" | "hero";
}

const { variant = "footer" } = Astro.props;
const iconClass = variant === "hero" ? "h-6 w-6" : "h-[18px] w-[18px]";
---

<div class="flex items-center">
  {
    footerLinks.map((link) => (
      <a
        href={link.url}
        aria-label={`Visit ${link.name}`}
        class="p-3 text-neutral-500 transition-colors hover:text-neutral-800 dark:hover:text-neutral-300"
        target={link.icon === "email" ? undefined : "_blank"}
        rel={link.icon === "email" ? undefined : "noopener noreferrer"}
      >
        {link.icon === "github" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class={iconClass}
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
          </svg>
        )}
        {link.icon === "email" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class={iconClass}
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
            <path d="M3 7l9 6l9 -6" />
          </svg>
        )}
      </a>
    ))
  }
</div>
