<div class="relative" data-theme-selector>
  <button
    data-theme-button
    data-open="false"
    type="button"
    aria-label="Select theme"
    aria-haspopup="listbox"
    aria-expanded="false"
    class="relative flex h-10 w-10 items-center justify-center rounded-full opacity-50 outline-hidden transition-opacity hover:opacity-100 focus-visible:ring-2 focus-visible:ring-neutral-200 data-[open=true]:bg-neutral-100 data-[open=true]:opacity-100 dark:focus-visible:ring-neutral-600 dark:data-[open=true]:bg-neutral-800"
  >
    <span data-theme-icon class="block h-5 w-5" aria-hidden="true"></span>
  </button>

  <div
    data-theme-menu
    role="listbox"
    class="absolute right-0 mt-2 hidden max-h-60 w-32 origin-top-right overflow-auto rounded-xl bg-white p-2 text-base shadow-lg ring-1 ring-black/5 backdrop-blur-lg focus:outline-none dark:bg-neutral-900 sm:text-sm xl:left-0 xl:right-[unset]"
  >
    {
      [
        { id: "system", label: "System" },
        { id: "light", label: "Light" },
        { id: "dark", label: "Dark" },
      ].map((theme) => (
        <button
          type="button"
          role="option"
          data-theme-option
          data-theme={theme.id}
          aria-selected="false"
          class="relative flex w-full select-none items-center rounded-md py-2 pl-10 pr-4 text-left text-sm hover:bg-neutral-100 dark:hover:bg-neutral-800"
        >
          <span data-theme-label class="block truncate font-normal">
            {theme.label}
          </span>

          <span
            data-theme-check
            class="absolute inset-y-0 left-0 hidden items-center pl-3"
            aria-hidden="true"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M18.0303 7.96967C18.3232 8.26256 18.3232 8.73744 18.0303 9.03033L11.0303 16.0303C10.7374 16.3232 10.2626 16.3232 9.96967 16.0303L5.96967 12.0303C5.67678 11.7374 5.67678 11.2626 5.96967 10.9697C6.26256 10.6768 6.73744 10.6768 7.03033 10.9697L10.5 14.4393L16.9697 7.96967C17.2626 7.67678 17.7374 7.67678 18.0303 7.96967Z"
                fill="currentColor"
              />
            </svg>
          </span>
        </button>
      ))
    }
  </div>

  <script is:inline>
    (() => {
      const root = document.currentScript?.parentElement;
      if (
        !(root instanceof HTMLElement) ||
        root.dataset.themeSelectorReady === "true"
      ) {
        return;
      }

      root.dataset.themeSelectorReady = "true";

      const button = root.querySelector("[data-theme-button]");
      const menu = root.querySelector("[data-theme-menu]");
      const icon = root.querySelector("[data-theme-icon]");
      const options = Array.from(root.querySelectorAll("[data-theme-option]"));
      const controller = window.__themeController;

      if (
        !(button instanceof HTMLButtonElement) ||
        !(menu instanceof HTMLElement) ||
        !(icon instanceof HTMLElement) ||
        !controller
      ) {
        return;
      }

      const lightIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path d="M10 2a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 2zM10 15a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 15zM10 7a3 3 0 100 6 3 3 0 000-6zM15.657 5.404a.75.75 0 10-1.06-1.06l-1.061 1.06a.75.75 0 001.06 1.06l1.06-1.06zM6.464 14.596a.75.75 0 10-1.06-1.06l-1.06 1.06a.75.75 0 001.06 1.06l1.06-1.06zM18 10a.75.75 0 01-.75.75h-1.5a.75.75 0 010-1.5h1.5A.75.75 0 0118 10zM5 10a.75.75 0 01-.75.75h-1.5a.75.75 0 010-1.5h1.5A.75.75 0 015 10zM14.596 15.657a.75.75 0 001.06-1.06l-1.06-1.061a.75.75 0 10-1.06 1.06l1.06 1.06zM5.404 6.464a.75.75 0 001.06-1.06l-1.06-1.06a.75.75 0 10-1.061 1.06l1.06 1.06z" />
        </svg>
      `;
      const darkIcon = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M7.455 2.004a.75.75 0 01.26.77 7 7 0 009.958 7.967.75.75 0 011.067.853A8.5 8.5 0 116.647 1.921a.75.75 0 01.808.083z" />
        </svg>
      `;

      const setOpen = (isOpen) => {
        button.dataset.open = String(isOpen);
        button.setAttribute("aria-expanded", String(isOpen));
        menu.classList.toggle("hidden", !isOpen);
      };

      const sync = () => {
        const theme = controller.getTheme();
        const resolvedTheme = controller.getResolvedTheme(theme);

        icon.innerHTML = resolvedTheme === "dark" ? darkIcon : lightIcon;

        options.forEach((option) => {
          if (!(option instanceof HTMLButtonElement)) {
            return;
          }

          const selected = option.dataset.theme === theme;
          const label = option.querySelector("[data-theme-label]");
          const check = option.querySelector("[data-theme-check]");

          option.setAttribute("aria-selected", String(selected));
          label?.classList.toggle("font-medium", selected);
          label?.classList.toggle("font-normal", !selected);
          check?.classList.toggle("hidden", !selected);
        });
      };

      setOpen(false);
      sync();

      button.addEventListener("click", () => {
        setOpen(button.dataset.open !== "true");
      });

      options.forEach((option) => {
        if (!(option instanceof HTMLButtonElement)) {
          return;
        }

        option.addEventListener("click", () => {
          const nextTheme = option.dataset.theme;

          if (
            nextTheme === "system" ||
            nextTheme === "light" ||
            nextTheme === "dark"
          ) {
            controller.setTheme(nextTheme);
            setOpen(false);
            sync();
          }
        });
      });

      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !root.contains(event.target)) {
          setOpen(false);
        }
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setOpen(false);
        }
      });

      window.addEventListener("themechange", sync);
    })();
  </script>
</div>
