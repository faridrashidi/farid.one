---
import { work } from "../../data/work";
import SectionTitle from "../SectionTitle.astro";

const yearFromDate = (value: string) => value.slice(0, 4);

const workRows = work.flatMap((entry) =>
  entry.positions.map((position) => ({
    company: entry.company,
    position,
  })),
);
---

<section>
  <SectionTitle title="Work" />

  <div class="flex flex-col">
    {
      workRows.map(({ company, position }) => {
        const startYear = yearFromDate(position.dateStart);
        const finishYear = position.dateFinish
          ? yearFromDate(position.dateFinish)
          : null;
        const Wrapper = company.href ? "a" : "div";

        return (
          <div class="flex">
            <div class="hidden sm:block">
              <div
                class="work-mark"
                style={`--work-accent-from: ${company.accentFrom}; --work-accent-to: ${company.accentTo};`}
                aria-hidden="true"
              >
                <span>{company.initials}</span>
              </div>
            </div>

            <div class="flex grow flex-col">
              <Wrapper
                href={company.href}
                class:list={[
                  "flex w-full items-start pb-2",
                  company.href && "transition-opacity hover:opacity-50",
                ]}
                target={company.href ? "_blank" : undefined}
                rel={company.href ? "noopener noreferrer" : undefined}
              >
                <div class="min-w-0 grow pb-3 sm:px-4">
                  <p class="font-medium">{position.title}</p>
                  <p class="opacity-50">
                    {company.name}
                    {position.team && <span> · {position.team}</span>}
                  </p>
                </div>

                <time
                  class="work-timestamp ml-auto shrink-0 whitespace-nowrap pl-4 text-right opacity-90"
                  datetime={position.dateStart}
                >
                  {startYear}
                  {finishYear !== startYear && (
                    <>
                      {" "}
                      -{" "}
                      {finishYear ? (
                        finishYear
                      ) : (
                        <em class="font-semibold">Now</em>
                      )}
                    </>
                  )}
                </time>
              </Wrapper>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .work-mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: linear-gradient(
      135deg,
      var(--work-accent-from),
      var(--work-accent-to)
    );
    box-shadow: 0 18px 38px -26px
      color-mix(in srgb, var(--work-accent-to) 65%, transparent);
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .work-timestamp em {
    font-style: italic;
  }

  @media (max-width: 639px) {
    .work-timestamp {
      padding-left: 0;
      text-align: left;
    }
  }
</style>
