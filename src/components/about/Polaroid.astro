---
import type { SportPhotoEntry } from "../../data/sport";

interface Props extends SportPhotoEntry {}

const { alt, label, rotationClass, src } = Astro.props;
---

<figure class:list={["sport-polaroid", rotationClass]}>
  <div class="sport-polaroid__image">
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  <figcaption class="sport-polaroid__label">{label}</figcaption>
</figure>

<style>
  .sport-polaroid {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, white 28%);
    border-radius: 1rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 94%, var(--color-surface) 6%) 0%,
      color-mix(in srgb, #f5f5f5 84%, var(--color-surface) 16%) 100%
    );
    box-shadow: 0 24px 50px -34px var(--color-shadow);
    padding: 1rem 1rem 1.35rem;
    transform-origin: center;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .sport-polaroid:hover {
    box-shadow: 0 28px 55px -34px var(--color-shadow);
    transform: translateY(-4px) rotate(0deg) !important;
  }

  .sport-polaroid--left {
    transform: rotate(-2.5deg);
  }

  .sport-polaroid--right {
    transform: rotate(1.75deg);
  }

  .sport-polaroid__image {
    overflow: hidden;
    border-radius: 0.35rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .sport-polaroid__image :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  .sport-polaroid__label {
    margin-top: 0.9rem;
    text-align: center;
    color: #525252;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  :global(.dark) .sport-polaroid {
    border-color: color-mix(in srgb, var(--color-border-strong) 78%, black 22%);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-surface-strong) 82%, #2a2a2a 18%) 0%,
      color-mix(in srgb, var(--color-bg) 84%, var(--color-surface-strong) 16%)
        100%
    );
  }

  :global(.dark) .sport-polaroid__label {
    color: color-mix(
      in srgb,
      var(--color-text) 78%,
      var(--color-text-muted) 22%
    );
  }

  @media (max-width: 639px) {
    .sport-polaroid--left,
    .sport-polaroid--right {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sport-polaroid {
      transition: none;
    }

    .sport-polaroid:hover,
    .sport-polaroid--left,
    .sport-polaroid--right {
      transform: none !important;
    }
  }
</style>
