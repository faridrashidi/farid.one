---
import type { SportPhotoEntry } from "../../data/sport";

interface Props extends Omit<SportPhotoEntry, "label" | "rotationClass"> {
  label?: string;
  rotationClass?: SportPhotoEntry["rotationClass"];
  width?: number;
  height?: number;
}

const { alt, label, rotationClass, src, width, height } = Astro.props;
---

<figure class:list={["sport-polaroid", rotationClass]}>
  <div class="sport-polaroid__image">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {label && <figcaption class="sport-polaroid__label">{label}</figcaption>}
</figure>

<style>
  .sport-polaroid {
    min-width: 0;
    margin: 0;
  }

  .sport-polaroid__image {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .sport-polaroid__image :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  .sport-polaroid__label {
    margin-top: 0.5rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (width < 640px) {
    .sport-polaroid {
      container-type: inline-size;
    }

    .sport-polaroid__image {
      width: fit-content;
      margin-inline: auto;
    }

    .sport-polaroid__image :global(img) {
      /* Match the landscape photos' 4:3 height without cropping portraits. */
      height: calc((100cqi - 2px) * 0.75);
      width: auto;
    }
  }
</style>
