---
import {
  fatherhoodContent as fatherhood,
  fatherhoodPhotos,
} from "../../data/fatherhood";
import SectionTitle from "../SectionTitle.astro";
import Polaroid from "./Polaroid.astro";
---

<section>
  <SectionTitle title="Fatherhood" />

  <div class="space-y-5">
    <p>{fatherhood.introduction}</p>

    <p>
      {fatherhood.recommendation.before}
      <a
        href={fatherhood.recommendation.href}
        class="font-medium underline decoration-[var(--color-border-strong)] underline-offset-4 transition-colors hover:decoration-current"
      >
        <cite>{fatherhood.recommendation.title}</cite>
      </a>
      {fatherhood.recommendation.after}
    </p>

    <blockquote
      class="border-l-2 border-[var(--color-border-strong)] pl-4 text-[var(--color-text-muted)]"
    >
      <p>{fatherhood.takeaway}</p>
    </blockquote>

    <p>{fatherhood.decision}</p>
  </div>

  <div
    class="fatherhood-gallery mx-auto mt-8 grid grid-cols-2 items-start gap-3 sm:max-w-[33.5rem] sm:gap-6"
  >
    {fatherhoodPhotos.map((photo) => <Polaroid {...photo} />)}
  </div>
</section>

<style>
  @media (width < 640px) {
    .fatherhood-gallery :global(.sport-polaroid) {
      display: grid;
      /* Size the caption column to the uncropped portrait, including its border. */
      grid-template-columns: calc((100% - 2px) * 0.95 * 0.75 + 2px);
      justify-content: end;
    }

    .fatherhood-gallery :global(.sport-polaroid__image img) {
      height: calc((100cqi - 2px) * 0.95);
    }

    .fatherhood-gallery :global(.sport-polaroid:last-child) {
      justify-content: start;
    }
  }
</style>
