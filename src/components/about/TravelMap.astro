---
import travelMapSvg from "./travel-map.svg?raw";

type Props = {
  homeCountry: string;
  visitedCountries: string[];
};

const { homeCountry, visitedCountries } = Astro.props as Props;

const countryAliasGroups = [
  ["Burma", "Myanmar"],
  ["Czech Republic", "Czechia"],
  ["Cote d'Ivoire", "Côte d'Ivoire", "Ivory Coast"],
  ["Dem. Rep. Korea", "North Korea"],
  ["Eswatini", "Swaziland"],
  ["Lao PDR", "Laos"],
  ["Macedonia", "North Macedonia"],
  ["Palestine", "Palestinian Territories"],
  ["Republic of Korea", "South Korea"],
  ["Russian Federation", "Russia"],
  ["Turkey", "Turkiye"],
  ["United Arab Emirates", "UAE"],
  ["United Kingdom", "UK"],
  ["United States", "United States of America", "US", "USA"],
] as const;

const countryElementPattern =
  /<(path|circle)\b[\s\S]*?\bdata-name="([^"]+)"[\s\S]*?>/g;
const statusClassNames = new Set(["home", "visited"]);

function normalizeCountryName(value: string) {
  return value
    .normalize("NFKD")
    .replace(/\p{M}/gu, "")
    .toLowerCase()
    .replace(/&/g, " and ")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function expandCountryNames(countryNames: string[]) {
  const expandedNames = new Set<string>();
  const normalizedAliasGroups = countryAliasGroups.map((group) =>
    group.map((countryName) => normalizeCountryName(countryName)),
  );

  for (const countryName of countryNames) {
    const normalizedName = normalizeCountryName(countryName);
    expandedNames.add(normalizedName);

    for (const aliasGroup of normalizedAliasGroups) {
      if (aliasGroup.includes(normalizedName)) {
        for (const alias of aliasGroup) {
          expandedNames.add(alias);
        }
      }
    }
  }

  return expandedNames;
}

function getCountryClasses(countryName: string) {
  const normalizedName = normalizeCountryName(countryName);
  const classes: string[] = [];

  if (visitedCountryNames.has(normalizedName)) {
    classes.push("visited");
  }

  if (homeCountryNames.has(normalizedName)) {
    classes.push("home");
  }

  return classes;
}

function decorateCountryElement(elementMarkup: string, countryName: string) {
  const baseClasses =
    elementMarkup
      .match(/\bclass="([^"]*)"/)?.[1]
      .split(/\s+/)
      .filter(Boolean)
      .filter((className) => !statusClassNames.has(className)) ?? [];
  const classes = [...baseClasses, ...getCountryClasses(countryName)];

  if (elementMarkup.includes('class="')) {
    return elementMarkup.replace(
      /\sclass="[^"]*"/,
      classes.length > 0 ? ` class="${classes.join(" ")}"` : "",
    );
  }

  if (classes.length === 0) {
    return elementMarkup;
  }

  return elementMarkup.replace(/>$/, ` class="${classes.join(" ")}">`);
}

const visitedCountryNames = expandCountryNames(visitedCountries);
const homeCountryNames = expandCountryNames([homeCountry]);
const decoratedSvg = travelMapSvg.replace(
  countryElementPattern,
  (elementMarkup, _tagName, countryName) =>
    decorateCountryElement(elementMarkup, countryName),
);
---

<style is:global>
  .map-travelling path {
    fill-rule: evenodd;
    stroke: #fff;
    fill: #e5e7eb;
  }

  html.dark .map-travelling path {
    stroke: #000;
  }

  html.dark .map-travelling path:not(.visited):not(.home) {
    stroke: #000;
    fill: rgb(32 32 32);
  }

  .map-travelling path.visited {
    fill: rgb(115 115 115);
    cursor: pointer;
    transition: fill 0.1s ease-out;
  }

  .map-travelling path.visited:hover {
    fill: rgb(163 163 163);
  }

  .map-travelling path.home {
    fill: rgb(239 68 68);
    cursor: pointer;
    transition: fill 0.1s ease-out;
  }

  .map-travelling path.home:hover {
    fill: rgb(248 113 113);
  }

  .map-travelling .country-marker {
    cursor: pointer;
    stroke: #fff;
    stroke-width: 0.8;
    transition: fill 0.1s ease-out;
  }

  html.dark .map-travelling .country-marker {
    stroke: #000;
  }

  .map-travelling .country-marker.visited {
    fill: rgb(115 115 115);
  }

  .map-travelling .country-marker.visited:hover {
    fill: rgb(163 163 163);
  }
</style>

<Fragment set:html={decoratedSvg} />
