---
import { education, educationPhotos } from "../../data/education";
import SectionTitle from "../SectionTitle.astro";
import Polaroid from "./Polaroid.astro";
---

<section>
  <SectionTitle title="Education" />

  <div class="flex flex-col">
    {
      education.map((entry) => {
        const Wrapper = entry.href ? "a" : "div";

        return (
          <div class="flex">
            <div class="sm:block shrink-0 items-center">
              <div
                class="education-mark"
                style={`--education-mark-padding: ${entry.markPadding ?? "0.45rem"}`}
                aria-hidden="true"
              >
                <img
                  src={entry.logoSrc}
                  alt=""
                  class="education-logo"
                  style={`--education-logo-offset-y: ${entry.logoOffsetY ?? "0px"}; --education-logo-scale: ${entry.logoScale ?? "1"}`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <div class="flex grow flex-col pl-3 sm:pl-0">
              <Wrapper
                href={entry.href}
                class:list={[
                  "flex w-full items-start pb-2",
                  entry.href && "transition-opacity hover:opacity-50",
                ]}
                target={entry.href ? "_blank" : undefined}
                rel={entry.href ? "noopener noreferrer" : undefined}
              >
                <div class="min-w-0 grow pb-3 sm:px-4">
                  <p class="font-medium">{entry.institution}</p>
                  <p class="opacity-50">{entry.degree}</p>
                </div>
              </Wrapper>
            </div>
          </div>
        );
      })
    }
  </div>

  <div
    class="mx-auto mt-8 grid max-w-64 items-start gap-6 sm:max-w-[33.5rem] sm:grid-cols-2"
  >
    {educationPhotos.map((photo) => <Polaroid {...photo} />)}
  </div>
</section>

<style>
  .education-mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: white;
    box-shadow: 0 18px 38px -26px var(--color-shadow);
    padding: var(--education-mark-padding, 0.45rem);
  }

  .education-logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transform: translateY(var(--education-logo-offset-y, 0))
      scale(var(--education-logo-scale, 1));
    transform-origin: center;
  }
</style>
