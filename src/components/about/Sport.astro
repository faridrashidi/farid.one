---
import { aboutContent } from "../../data/profile";
import { sportPhotos } from "../../data/sport";
import SectionTitle from "../SectionTitle.astro";
---

<section>
  <SectionTitle title="Sport" />

  <div class="space-y-5">
    {aboutContent.sport.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="sport-gallery">
    {
      sportPhotos.map((photo) => (
        <figure class:list={["sport-polaroid", photo.rotationClass]}>
          <div class="sport-polaroid__image">
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="sport-polaroid__label">{photo.label}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .sport-gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .sport-polaroid {
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, white 28%);
    border-radius: 1rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 94%, var(--color-surface) 6%) 0%,
      color-mix(in srgb, #f5f5f5 84%, var(--color-surface) 16%) 100%
    );
    box-shadow: 0 24px 50px -34px var(--color-shadow);
    padding: 1rem 1rem 1.35rem;
    transform-origin: center;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .sport-polaroid:hover {
    box-shadow: 0 28px 55px -34px var(--color-shadow);
    transform: translateY(-4px) rotate(0deg) !important;
  }

  .sport-polaroid--left {
    transform: rotate(-2.5deg);
  }

  .sport-polaroid--right {
    transform: rotate(1.75deg);
  }

  .sport-polaroid__image {
    overflow: hidden;
    border-radius: 0.35rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .sport-polaroid__image :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  .sport-polaroid__label {
    margin-top: 0.9rem;
    text-align: center;
    color: #525252;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  :global(.dark) .sport-polaroid {
    border-color: color-mix(in srgb, var(--color-border-strong) 52%, white 48%);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, #f1f5f9 92%, var(--color-surface-strong) 8%) 0%,
      color-mix(in srgb, #d4d4d8 82%, var(--color-surface-strong) 18%) 100%
    );
  }

  :global(.dark) .sport-polaroid__label {
    color: #404040;
  }

  @media (min-width: 640px) {
    .sport-gallery {
      align-items: start;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .sport-polaroid--left,
    .sport-polaroid--right {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sport-polaroid {
      transition: none;
    }

    .sport-polaroid:hover,
    .sport-polaroid--left,
    .sport-polaroid--right {
      transform: none !important;
    }
  }
</style>
