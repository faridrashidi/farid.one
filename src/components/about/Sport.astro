---
import { aboutContent } from "../../data/profile";
import { sportPhotos } from "../../data/sport";
import SectionTitle from "../SectionTitle.astro";
import Polaroid from "./Polaroid.astro";
---

<section>
  <SectionTitle title="Sport" />

  <div class="space-y-5">
    {aboutContent.sport.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <div class="sport-gallery">
    {sportPhotos.map((photo) => <Polaroid {...photo} />)}
  </div>
</section>

<style>
  .sport-gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .sport-gallery {
      align-items: start;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
