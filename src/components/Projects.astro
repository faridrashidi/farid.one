---
const projects = [
  {
    name: "Kaggle Solutions",
    description:
      "The Most Comprehensive Collection of Kaggle Competition Solutions and Ideas",
    url: "https://kaggle.farid.one/",
    image:
      "https://raw.githubusercontent.com/faridrashidi/kaggle-solutions/main/public/assets/images/logo.png",
    imageAlt: "Logo mark for KaggleSolutions",
  },
  {
    name: "CNSPlots",
    description:
      "Toolkit for Generating Publication Quality Plots for Cell, Nature and Science Journals",
    url: "https://cnsplots.farid.one/",
    image:
      "https://raw.githubusercontent.com/faridrashidi/cnsplots/main/docs/_static/images/logo.svg",
    imageAlt: "Logo mark for CNSPlots",
  },
  {
    name: "MafiaDealer",
    description:
      "اپلیکیشن رایگان بازی مافیا با بیش از ۲۵ سناریو و مدیریت کامل بازی با کارت‌های دیجیتال",
    descriptionLang: "fa",
    descriptionDir: "rtl",
    url: "https://mafia.farid.one/",
    image: "https://mafia.farid.one/img/icons/android-chrome-192x192.png",
    imageAlt: "Logo mark for MafiaDealer",
  },
];
---

<section class="projects-section py-8 sm:py-12" aria-label="Projects">
  <div class="projects-grid">
    {
      projects.map((project, index) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["project-card", index === 2 && "project-card--centered"]}
        >
          <div class="project-card__top">
            <div class="project-card__header">
              <img
                src={project.image}
                alt={project.imageAlt}
                class="project-card__logo"
                loading="lazy"
              />
              <h3 class="project-card__title">{project.name}</h3>
            </div>
          </div>
          <p
            class="project-card__description"
            lang={project.descriptionLang}
            dir={project.descriptionDir}
          >
            {project.description}
          </p>
        </a>
      ))
    }
  </div>
</section>
