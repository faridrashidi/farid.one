---
interface Props {
  href?: string;
  title: string;
  viewAll?: boolean;
}

const { href, title, viewAll = false } = Astro.props;
---

{
  href ? (
    <a href={href} class="group my-6 flex items-center justify-between gap-3">
      <h2 class="text-lg font-bold underline-offset-4 group-hover:underline">
        {title}
      </h2>
      {viewAll && (
        <span class="rounded-lg border border-neutral-200 bg-white px-2 py-[3px] text-center text-xs dark:border-neutral-700 dark:bg-neutral-900">
          View all →
        </span>
      )}
    </a>
  ) : (
    <h2 class="my-6 block text-lg font-bold">{title}</h2>
  )
}
