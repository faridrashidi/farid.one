---
import { formatFullDate, formatMonthDay } from "../../lib/formatters";

interface Props {
  date: Date;
  href: string;
  language?: "en" | "fa";
  title: string;
}

const { date, href, language = "en", title } = Astro.props;
---

<li
  class="-mx-3 rounded-lg transition-all hover:bg-neutral-100 focus-within:bg-neutral-100 dark:hover:bg-neutral-900 dark:focus-within:bg-neutral-900"
>
  <a
    href={href}
    title={title}
    class="flex flex-col-reverse gap-1 rounded-lg px-3 py-2 text-[15px] outline-hidden focus:ring-2 focus:ring-neutral-300 dark:focus:ring-neutral-500 sm:flex-row sm:gap-2 sm:py-2"
  >
    <time
      class="opacity-60 sm:w-20"
      datetime={date.toISOString()}
      aria-label={`Written ${formatFullDate(date)}`}
    >
      {formatMonthDay(date)}
    </time>

    <div class="flex-1">
      <p
        class="font-medium"
        dir={language === "fa" ? "rtl" : undefined}
        lang={language}
      >
        {title}
      </p>
    </div>
  </a>
</li>
