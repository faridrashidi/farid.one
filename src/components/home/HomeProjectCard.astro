---
import type { ProjectEntry } from "../../data/projects";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const href = project.siteUrl;
const isRTL =
  project.titleLanguage === "fa" || project.summaryLanguage === "fa";
---

<a
  class="grid gap-2.5 rounded-xl border border-neutral-200 px-5 py-4 transition-all hover:bg-neutral-100 focus:border-neutral-300 focus-within:bg-neutral-100 focus:outline-none dark:border-neutral-800 dark:hover:bg-neutral-900 dark:focus:border-neutral-500 dark:focus-within:bg-neutral-900"
  data-github-repo={project.githubRepo}
  dir={isRTL ? "rtl" : undefined}
  href={href}
  rel="noopener noreferrer"
  target="_blank"
  title={project.title}
>
  <p class="font-semibold" lang={project.titleLanguage}>
    {project.title}
  </p>
  <p class="text-sm opacity-70" lang={project.summaryLanguage}>
    {project.summary}
  </p>
  <div
    class="flex min-h-5 items-center gap-2.5 text-sm"
    aria-live={project.githubRepo ? "polite" : undefined}
  >
    {
      project.githubRepo && (
        <>
          <p class="text-[var(--color-text-muted)]" data-github-loading>
            Loading GitHub...
          </p>

          <div class="hidden items-center gap-1" data-github-language>
            <div
              class="h-2 w-2 rounded-full project-language-dot"
              data-github-language-dot
            />
            <span class="opacity-70" data-github-language-name />
          </div>

          <div class="hidden items-center gap-1" data-github-stars>
            <svg
              class="p-[1.5px] opacity-70"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="currentColor"
            >
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
            </svg>
            <span class="opacity-70" data-github-stars-count />
          </div>
        </>
      )
    }
  </div>
</a>
