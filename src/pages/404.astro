---
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import Wrapper from "../components/Wrapper.astro";
import { siteFeatures } from "../data/profile";

export const prerender = true;

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  ...(siteFeatures.blogEnabled ? [{ href: "/blog", label: "Blog" }] : []),
];
---

<Layout title="Page not found">
  <Wrapper>
    <div class="sm:py-10">
      <PageTitle title="Are you lost?" />
      <h2 class="pb-4 text-xl">
        The page you are looking for doesn&apos;t exist.
      </h2>
      <h3 class="text-lg">Here are some helpful links instead:</h3>
      <ul
        class="list-inside list-disc px-4 py-8 text-lg underline underline-offset-2"
      >
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <h4 class="text-lg font-extrabold">Error code: 404</h4>
    </div>
  </Wrapper>
</Layout>
