---
import ArchivePostItem from "../../components/blog/ArchivePostItem.astro";
import YearHeading from "../../components/blog/YearHeading.astro";
import NotFound from "../../components/NotFound.astro";
import PageTitle from "../../components/PageTitle.astro";
import Wrapper from "../../components/Wrapper.astro";
import { siteFeatures } from "../../config/site";
import { getBlogEntryPath, getSortedBlogPosts } from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const posts = siteFeatures.blogEnabled
  ? await getSortedBlogPosts()
  : [];

const postsByYear = posts.reduce<Record<string, typeof posts>>(
  (groups, post) => {
    const year = String(post.data.publishedAt.getUTCFullYear());
    groups[year] ??= [];
    groups[year].push(post);
    return groups;
  },
  {},
);

const years = Object.keys(postsByYear).sort(
  (left, right) => Number(right) - Number(left),
);
const fallbackLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
];

if (!siteFeatures.blogEnabled) {
  Astro.response.status = 404;
}
---

<Layout title={siteFeatures.blogEnabled ? "Blog" : "Page not found"}>
  <Wrapper>
    {
      siteFeatures.blogEnabled ? (
        <main>
          <PageTitle title="Blog" />

          <div class="grid gap-8">
            {years.map((year) => (
              <section>
                <YearHeading year={year} />

                <ul class="grid grid-flow-row gap-3">
                  {postsByYear[year].map((post) => (
                    <ArchivePostItem
                      href={`/blog/${getBlogEntryPath(post.id)}`}
                      title={post.data.title}
                      date={post.data.publishedAt}
                      language={post.data.language}
                    />
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </main>
      ) : (
        <NotFound links={fallbackLinks} />
      )
    }
  </Wrapper>
</Layout>
