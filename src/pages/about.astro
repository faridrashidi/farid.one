---
import Sport from "../components/about/Sport.astro";
import Travelling from "../components/about/Travelling.astro";
import WhoAmI from "../components/about/WhoAmI.astro";
import Education from "../components/about/Education.astro";
import PageTitle from "../components/PageTitle.astro";
import Wrapper from "../components/Wrapper.astro";
import Layout from "../layouts/Layout.astro";
import { siteFeatures } from "../data/profile";

export const prerender = true;
---

<Layout title="About">
  <Wrapper>
    <main>
      <PageTitle title="About me" />
      <WhoAmI />
      {siteFeatures.educationEnabled && <Education />}
      {siteFeatures.sportEnabled && <Sport />}
      <Travelling />
    </main>
  </Wrapper>
</Layout>
