---
import { getCollection } from "astro:content";

import Projects from "../components/home/Projects.astro";
import Biography from "../components/home/Biography.astro";
import Writings from "../components/home/Writings.astro";
import { curatedProjects } from "../data/projects";
import { siteFeatures } from "../data/profile";
import { getBlogEntryPath } from "../lib/blog";
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const posts = siteFeatures.blogEnabled
  ? (await getCollection("blog"))
      .sort(
        (left, right) =>
          right.data.publishedAt.getTime() - left.data.publishedAt.getTime(),
      )
      .slice(0, 8)
      .map((post) => ({
        language: post.data.language,
        publishedAt: post.data.publishedAt,
        slug: getBlogEntryPath(post.id),
        title: post.data.title,
      }))
  : [];
---

<Layout>
  <Biography />
  {siteFeatures.blogEnabled && <Writings posts={posts} />}
  <Projects projects={curatedProjects} />
</Layout>
